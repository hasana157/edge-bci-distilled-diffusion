# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.pyo

# Virtual environments
venv/
env/
.venv/
.env/

# Test and coverage output
.pytest_cache/
.coverage
htmlcov/

# Large data files: download separately, see data/raw/README.md
data/raw/*.mat
data/raw/*.gdf
data/processed/*.npy
data/processed/*.npz
C-/

# Large model checkpoints: publish through releases or external storage
models/**/*.pt
models/**/*.pth
checkpoints/
*.pt

# Keep small/readable ONNX exports if intentionally added
!models/onnx/*.onnx

# Jupyter and Colab scratch output
.ipynb_checkpoints/
*.ipynb

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
!results/README.md

# Temporary files
*.tmp
*.bak
