{
  "version": 2,
  "builds": [
    {
      "src": "dashboard/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/models/onnx/(.*)",
      "dest": "models/onnx/$1"
    },
    {
      "src": "/(style\\.css|app\\.js.*|package\\.json)",
      "dest": "dashboard/$1"
    },
    {
      "src": "/(.*)",
      "dest": "dashboard/index.html"
    }
  ]
}
